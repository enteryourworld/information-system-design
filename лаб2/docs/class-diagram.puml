@startuml
!pragma layout smetana
title ЛР2 — репозитории клиентов гостиницы
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
hide empty members

class Client <<record>> {
  - id: long {readOnly}
  - lastName: String {readOnly}
  - firstName: String {readOnly}
  - patronymic: String {readOnly}
  - phone: String {readOnly}
  - birthday: LocalDate {readOnly}
  - passport: String {readOnly}
  - comment: String {readOnly}
  + Client(lastName: String, firstName: String, patronymic: String, phone: String, birthday: LocalDate, passport: String, comment: String)
  + this()
  - {static} validName(value: String): String
  + withId(newId: long): Client
  + isSameClient(other: Client): boolean
  + equals(other: Object): boolean
  + hashCode(): int
}

class ClientDbAdapter {
  - adaptee: ClientRepDb
  + ClientDbAdapter(adaptee: ClientRepDb)
}

class ClientDocument <<record>> {
  - nextId: long {readOnly}
  - clients: List<Client> {readOnly}
}

class ClientFileCodec {
  - mapper: ObjectMapper
  - ClientFileCodec(mapper: ObjectMapper)
  + {static} json(): ClientFileCodec
  + {static} yaml(): ClientFileCodec
  + read(path: Path): ClientDocument
  + write(path: Path, document: ClientDocument): void
}

class ClientFilter <<record>> {
  - lastNamePrefix: String {readOnly}
  - phoneContains: String {readOnly}
  - commentContains: String {readOnly}
  + {static} all(): ClientFilter
  - {static} normalize(text: String): String
  + matches(client: Client): boolean
}

class ClientQuery <<record>> {
  - filter: ClientFilter {readOnly}
  - sort: ClientSort {readOnly}
  - direction: SortDirection {readOnly}
  + {static} all(): ClientQuery
  + comparator(): Comparator<Client>
}

class ClientRepDb {
  - database: Database
  - sortedByLastName: boolean
  + ClientRepDb()
  + initializeSchema(): void
  + findById(id: long): Optional<Client>
  + fetchPage(k: int, n: int): List<ClientShort>
  + fetchPage(k: int, n: int, query: ClientQuery): List<ClientShort>
  + sortByLastName(): void
  + insert(client: Client): Client
  + bindClient()
  + update(id: long, client: Client): boolean
  + bindClient()
  + remove(id: long): boolean
  + count(): long
  + count(query: ClientQuery): long
  - {static} bindClient(statement: PreparedStatement, client: Client): void
  - {static} readClient(rows: ResultSet): Client
}

class ClientRepJson {
  - delegate: FileClientRepository
  + ClientRepJson(path: Path)
}

class ClientRepYaml {
  - delegate: FileClientRepository
  + ClientRepYaml(path: Path)
}

interface ClientRepository {
  + getById(id: long): Optional<Client>
  + getKNShortList(k: int, n: int): List<ClientShort>
  + sortByLastName(): void
  + add(client: Client): Client
  + replace(id: long, client: Client): boolean
  + delete(id: long): boolean
  + getCount(): long
}

class ClientShort <<record>> {
  - id: long {readOnly}
  - name: String {readOnly}
  - phone: String {readOnly}
}

enum ClientSort {
  + comparator(): Comparator<Client>
  + sqlColumn(): String
}

class Database {
  - url: String
  - user: String
  - password: String
  - Database()
  + {static} getInstance(): Database
  + withConnection(work: SqlWork<T>): T
  + execute(connection: Connection): T
}

class DatabaseQueryDecorator {
  - delegate: ClientDbAdapter
  + DatabaseQueryDecorator(delegate: ClientDbAdapter)
}

class FileClientRepository {
  - path: Path
  - codec: ClientFileCodec
  - clients: List<Client>
  - nextId: long
  + FileClientRepository(path: Path, codec: ClientFileCodec)
  + readAll(): List<Client>
  + writeAll(): void
  + getById(id: long): Optional<Client>
  + getKNShortList(k: int, n: int): List<ClientShort>
  + sortByLastName(): void
  + add(client: Client): Client
  + replace(id: long, client: Client): boolean
  + delete(id: long): boolean
  + getCount(): long
  - checkPassport(passport: String, excludedId: long): void
}

class FileQueryDecorator {
  - delegate: FileRepository
  + FileQueryDecorator(delegate: FileRepository)
}

interface FileRepository {
  + readAll(): List<Client>
  + writeAll(): void
  + snapshot(): List<Client>
}

class Mapper {
  - Mapper()
  + {static} toShortClient(client: Client): ClientShort
}

interface QueryableClientRepository {
  + getKNShortList(k: int, n: int, query: ClientQuery): List<ClientShort>
  + getCount(query: ClientQuery): long
}

interface RepositoryDecorator {
  + delegate(): ClientRepository
}

enum SortDirection {
}

class SqlQuery <<record>> {
  - where: String {readOnly}
  - parameters: List<String> {readOnly}
  - orderBy: String {readOnly}
  + {static} from(query: ClientQuery): SqlQuery
  - {static} add(clauses: List<String>, parameters: List<String>, column: String, value: String, prefix: boolean): void
  + bind(statement: PreparedStatement): int
}

FileRepository --|> ClientRepository
ClientRepJson ..|> FileRepository
ClientRepYaml ..|> FileRepository
FileClientRepository ..|> FileRepository
ClientRepJson --> FileClientRepository : делегирует
ClientRepYaml --> FileClientRepository : делегирует
FileClientRepository --> ClientFileCodec : формат
ClientFileCodec ..> ClientDocument : кодирует
ClientDocument --> Client : clients
ClientRepository ..> Client : CRUD
ClientRepository ..> ClientShort : страницы
Mapper ..> Client
Mapper ..> ClientShort : создаёт
ClientRepDb --> Database : делегирует SQL
ClientDbAdapter ..|> ClientRepository
ClientDbAdapter --> ClientRepDb : Adapter
QueryableClientRepository --|> ClientRepository
RepositoryDecorator --|> ClientRepository
DatabaseQueryDecorator ..|> RepositoryDecorator
DatabaseQueryDecorator ..|> QueryableClientRepository
DatabaseQueryDecorator --> ClientDbAdapter : оборачивает
ClientDbAdapter ..|> QueryableClientRepository
FileQueryDecorator ..|> RepositoryDecorator
FileQueryDecorator ..|> QueryableClientRepository
FileQueryDecorator --> FileRepository : оборачивает
ClientQuery --> ClientFilter
ClientQuery --> ClientSort
ClientQuery --> SortDirection
SqlQuery ..> ClientQuery : параметры
ClientRepDb ..> SqlQuery
DatabaseQueryDecorator ..> ClientQuery
FileQueryDecorator ..> ClientQuery
@enduml
